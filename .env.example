# 🔑 API 密钥配置 / API Key Configuration

# 1. 新闻数据密钥 (必填) / News API Key (Required)
# 获取地址: https://newsapi.org/register
NEWS_API_KEY="你的NewsAPI密钥"

# 2. AI 大脑密钥 (推荐) / AI Brain Key (Recommended)
# 您可以在应用界面的“设置”中配置，也可以在这里预设环境变量
# Gemini (默认): https://aistudio.google.com/
GEMINI_API_KEY="你的Gemini密钥"

# 兼容 OpenAI 格式的 API (如 OpenAI, DeepSeek, Groq 等)
# Compatible with OpenAI-format APIs (e.g. OpenAI, DeepSeek, Groq)
OPENAI_API_KEY="你的API密钥"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL_NAME="gpt-4o-mini" # 或 deepseek-chat, llama3 等

# 3. 自动生成的应用链接 / App URL (Auto-injected)
APP_URL="MY_APP_URL"
